# Al Qasim Movers — Apache config for Hostinger shared hosting.
# Deployed to public_html/.htaccess by the build (dist/.htaccess).

# ----------------------------------------------------------------- security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  # Start in Report-Only; switch the header name to Content-Security-Policy once reports are clean.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  # Long cache for fingerprintable assets, none for HTML
  <FilesMatch "\.(css|js|woff2|svg|png|jpg|jpeg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------- compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------------- character set
AddDefaultCharset UTF-8
AddType font/woff2 .woff2

# ----------------------------------------------------------------- canonical URLs
RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 2. Force non-www (canonical host)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 3. Add the trailing slash to directory URLs (so /services/villa-movers-dubai → …/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# ----------------------------------------------------------------- error page
ErrorDocument 404 /404.html

# ----------------------------------------------------------------- hardening
Options -Indexes
<IfModule mod_rewrite.c>
  # Block dotfiles and anything that should never be public
  RewriteRule "(^|/)\." - [F]
</IfModule>
<FilesMatch "\.(sql|md|json|log|ini|sample\.php)$">
  Require all denied
</FilesMatch>
# lib.php only defines helpers; it should never be requested directly
<Files "lib.php">
  Require all denied
</Files>
# site.webmanifest is JSON but must stay public
<Files "site.webmanifest">
  Require all granted
</Files>
